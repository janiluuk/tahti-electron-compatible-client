# Build-time (Vite). Leave VITE_TAHTI_API_URL unset in production so the
# browser uses same-origin /tahti-api (proxied by nginx → api.tahti.live).

# Absolute API base (dev/CORS testing only). Prefer proxy in prod.
# VITE_TAHTI_API_URL=https://api.tahti.live

# Dev-server proxy target (vite.config.ts). Not baked into the client bundle.
VITE_TAHTI_API_PROXY_TARGET=http://localhost:15011

# Force mock data (offline demo). Login: demo@tahti.live / any password.
# See packages/tahti-web/MOCKS.md
# VITE_FORCE_MOCK=1

# Centrifugo websocket (production beta build)
VITE_CENTRIFUGO_WS=wss://chat.tahti.live/connection/websocket

# Optional hCaptcha site key for chat gate
# VITE_HCAPTCHA_SITEKEY=

# Dev bind
# VITE_HOST=0.0.0.0
