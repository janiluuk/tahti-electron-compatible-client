    "lint": "eslint .",
    "clean": "rm -rf dist .turbo node_modules/.vite",
    "deploy:vimage": "./deploy/deploy-vimage.sh"
  },
  "dependencies": {
    "@nuclearplayer/model": "workspace:*",
