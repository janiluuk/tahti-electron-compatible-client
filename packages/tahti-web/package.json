{
  "name": "@nuclearplayer/tahti-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "POC: Tahti listen experience on Nuclear UI — eventual production web listen client",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
